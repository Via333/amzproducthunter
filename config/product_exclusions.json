  "product_rules": [
    {
      "id": "garbage_disposal_equipment",
      "reason": "厨余处理电器整机，不符合当前低售后风险范围",
      "subject_only": true,
      "title_patterns": [
        "\\b(?:garbage dispos(?:al|er)s?|(?:food )?waste dispos(?:al|er)s?|(?:food|sink) disposers?)\\b"
      ],
      "accessory_patterns": [
        "\\b(?:garbage dispos(?:al|er)s?|(?:food )?waste dispos(?:al|er)s?|sink disposers?)\\s+(?:(?!(?:with|and|includes?)\\b)[a-z0-9]+\\s+){0,6}(?:guards?|baffles?|stoppers?|plugs?|seals?|gaskets?|flanges?|couplers?|adapters?|switch(?:es)?|buttons?|hoses?|tubes?|pipes?|brush(?:es)?|cleaners?|parts?|accessor(?:y|ies)|installation kits?)\\b"
