        "\\bvacuum (?:storage|compression|seal) bags?\\b",
        "\\b(?:manual|hand) (?:floor scrubbers?|vacuum pumps?)\\b",
        "\\b(?:electric|cordless|power) (?:drill|tool|saw) (?:holders?|holsters?|racks?|pouches?|organizers?)\\b",
        "\\b(?:filters?|mop pads?|dust bags?|brush heads?|nozzles?)\\b"
      ],
      "leaf_patterns": [
        "^(?:steam cleaners?|steam mops?|handheld steamers?|handheld vacuums?|upright vacuums?|canister vacuums?|stick vacuums?|robotic vacuums?|wet dry vacuums?|floor scrubbers?|electric motors?|air compressors?|welders?)$"
